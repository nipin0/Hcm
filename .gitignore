# ===== secrets & agent data (NEVER commit) =====
.workbuddy/
.env
*.env
*.env.*

# ===== build / cache artifacts =====
node_modules/
dist/
__pycache__/
*.pyc
.pytest_cache/

# ===== production dumps & scratch/backups (may contain LIVE secrets) =====
# backup/ holds production Redis/DB dumps that include a live DeepSeek API key
# (appendonly.aof) -> must NOT be pushed. Sanitize before versioning if ever needed.
backup/
hcm-v2/tools/_scratch/
hcm-v2/tools/_baseline/
hcm-v2/tools/archive/
hcm-v2/hcm-web/frontend/dist_bak*/
hcm-v2/hcm-web/frontend/dist_old/
hcm-v2/hcm-web/frontend/_scratch/

# ===== logs =====
*.log

# ===== runtime / generated (do not version) =====
hcm-v2/tools/bridge_launcher.lock
*.bak
hcm-v2/tools/_artifacts/snapshots/
hcm-v2/tools/_artifacts/_scratch_*

# ===== AI model weights / calibrators (auto-retrained & shadow-elected at runtime) =====
# 模型由 auto_retrain.py 训练 + 影子选举写入 ai.lm.model_path，无需进版本库（避免仓库膨胀/泄版本）。
hcm-v2/tools/models/*.pkl
hcm-v2/tools/models/lgbm_quality_v*.txt
hcm-v2/tools/_artifacts/lgbm_quality_v*.txt
hcm-v2/tools/_artifacts/lgbm_state.pkl
hcm-v2/tools/_artifacts/features*.csv
hcm-v2/tools/_artifacts/labels*.csv

# ===== session debug / scratch leftovers (never commit) =====
_diag*.txt
hcm-v2/_diag*.txt
hcm-v2/tools/_tmp*.py
hcm-v2/tools/_tmp*.txt
$null
disp*.txt
risk_*.txt
_scratch/
*.bak_*
铁律.md
docs/hexp_direction
hcm-v2/hcm-web/web/api/*.bak_*
hcm-v2/shared/*.bak_*
