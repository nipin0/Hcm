  { key: 'pretrend_cooldown_seconds', label: 'PRE_TREND 冷却(秒)', type: 'number', defaultValue: 180, min: 0, max: 7200, group: 'cooldown',
    description: '市场处于 PRE_TREND（预趋势）状态时，发出新信号前的最小间隔。越大越保守，避免假突破。建议 120-300。' },
  { key: 'trend_cooldown_seconds', label: 'TREND 冷却(秒)', type: 'number', defaultValue: 120, min: 0, max: 7200, group: 'cooldown',
    description: '市场处于 TREND（已确认趋势）状态时，新信号间隔。趋势确认后信号较可靠，可设较短。建议 60-180。' },
  { key: 'fade_cooldown_seconds', label: 'FADE 冷却(秒)', type: 'number', defaultValue: 300, min: 0, max: 7200, group: 'cooldown',
